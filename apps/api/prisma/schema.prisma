generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECRUITER
}

enum Track {
  COMPANY_DRIVER
  OWNER_OPERATOR
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

enum Stage {
  NEW_LEAD
  CONTACTED
  QUALIFIED
  INTERVIEW
  OFFER
  HIRED
  ON_HOLD
  REJECTED
  WITHDRAWN
  UNRESPONSIVE
  DUPLICATE
}

model Staff {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role
  active       Boolean @default(true)
  mfaCiphertext String?
  mfaLastStep  Int?
  sessions     Session[]
  candidates   Candidate[]
  followUps    FollowUp[]
}

model Session {
  hash      String @id
  expiresAt DateTime
  mfaVerified Boolean @default(false)
  staffId   String
  staff     Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([staffId])
}

model Job {
  id           String @id @default(uuid())
  slug         String @unique
  title        String
  track        Track
  region       String
  requirements String
  schedule     String
  equipment    String
  compensation String?
  status       JobStatus @default(DRAFT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications Application[]

  @@index([status, track])
}

model Candidate {
  id           String @id @default(uuid())
  name         String
  email        String
  phone        String
  state        String?
  zip          String?
  track        Track
  stage        Stage @default(NEW_LEAD)
  stageReason  String?
  recruiterId  String?
  recruiter    Staff? @relation(fields: [recruiterId], references: [id])
  createdAt    DateTime @default(now())
  applications Application[]
  extendedApplication ExtendedApplication?
  notes        Note[]
  audit        Audit[]
  followUps    FollowUp[]

  @@unique([phone, track])
  @@index([stage, createdAt])
  @@index([createdAt])
}

model Application {
  id          String @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  jobId       String?
  job         Job? @relation(fields: [jobId], references: [id])
  details     Json
  createdAt   DateTime @default(now())
  consent     Consent?

  @@index([candidateId, createdAt])
  @@index([createdAt])
}

model Consent {
  applicationId String @id
  application   Application @relation(fields: [applicationId], references: [id])
  version       String
  statement     String
  acceptedAt    DateTime @default(now())
}

model ExtendedApplication {
  candidateId String @id
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  invitationId String @unique
  tokenHash   String @unique
  issuedAt    DateTime
  expiresAt   DateTime
  revokedAt   DateTime?
  submittedAt DateTime?
  answers     Json?
  draft       Json?
  draftSavedAt DateTime?
  revision    Int @default(0)
}

model Note {
  id          String @id @default(uuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  authorId    String
  body        String
  createdAt   DateTime @default(now())

  @@index([candidateId, createdAt])
}

model FollowUp {
  id           String @id @default(uuid())
  candidateId  String
  candidate    Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assigneeId   String
  assignee     Staff @relation(fields: [assigneeId], references: [id])
  title        String
  dueAt        DateTime
  completedAt  DateTime?
  canceledAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([assigneeId, completedAt, canceledAt, dueAt, id])
  @@index([candidateId, completedAt, canceledAt, dueAt])
}

model Audit {
  id          String @id @default(uuid())
  actorId     String?
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  action      String
  subjectId   String
  data        Json?
  createdAt   DateTime @default(now())

  @@index([candidateId, createdAt])
  @@index([subjectId, createdAt])
}
